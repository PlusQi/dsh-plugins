{
  "name": "dsh-tokstats",
  "version": "0.7.0",
  "description": "个人 DSH 扩展集：单轮 token 三点式预告（tokprev）、跨会话 token 分析全局面板（tokstats，注册官方会话投影单元）与 composer 草稿保真结构化重排（promptopt，含 host 旁路模型调用与使用计数）等插件的集合包",
  "type": "module",
  "main": "lib/index.js",
  "icon": "icon.svg",
  "author": "PlusQi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PlusQi/dsh-tokstats.git"
  },
  "homepage": "https://github.com/PlusQi/dsh-tokstats",
  "bugs": {
    "url": "https://github.com/PlusQi/dsh-tokstats/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "token",
    "usage",
    "analytics",
    "ui"
  ],
  "engines": {
    "dsh": "0.2.1-rc.3"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "guard": "node scripts/check-plugin-structure.js"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.3": "compatible"
      }
    }
  },
  "files": [
    "lib",
    "locale",
    "screenshots.json",
    "docs/assets/tokstats.png",
    "docs/assets/tokstats-en.png",
    "docs/assets/tokprev.png",
    "docs/assets/tokprev-en.png",
    "icon.svg",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "AGENTS.md",
    "docs/MAINTAINING.md",
    "docs/INVARIANTS.md"
  ],
  "license": "MIT"
}

